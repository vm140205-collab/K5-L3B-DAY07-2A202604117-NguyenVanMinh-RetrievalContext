# Copy to .env and fill in your key. .env is git-ignored; never commit real keys.
# Any OpenAI-compatible endpoint works (Mistral, OpenAI, DeepSeek, Groq, OpenRouter,
# Ollama, vLLM, ...). Defaults to Mistral; MISTRAL_API_KEY is accepted as fallback.
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=mistral-small-latest
